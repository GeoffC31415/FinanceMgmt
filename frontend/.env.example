# FinanceMgmt Frontend Configuration
# Copy this file to .env and adjust values as needed.

# Base URL for the Python backend API.
# If the backend runs on the same host, this can be left empty or set to the backend port.
# Examples:
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_BASE_URL=https://api.finance-mgmt.example.com
VITE_API_BASE_URL=http://localhost:8000
